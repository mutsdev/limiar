# Copie para .env e ajuste o que precisar. O .env não é versionado.
# Todas as chaves são opcionais: sem .env, os padrões abaixo já valem.

# Onde fica o banco. Padrão: ~/Documents/dados-fluxo/fluxo.db
#
# Deixe FORA de pasta sincronizada em nuvem. OneDrive, Drive ou Dropbox
# sincronizando um SQLite durante a escrita corrompe o arquivo.
CAMINHO_BANCO=

# Vídeos, gravações, contagens manuais e saídas anotadas.
# Padrão: a pasta `dados/` do repositório, que o .gitignore já protege.
CAMINHO_DADOS=

# Onde o agente entrega os eventos.
URL_SERVICO=http://127.0.0.1:8000

# Logs (rotação diária) e backups do banco. Padrão: junto do banco, em
# ~/Documents/dados-fluxo/logs e ~/Documents/dados-fluxo/backups.
CAMINHO_LOGS=
CAMINHO_BACKUPS=

# Pesos de modelo baixados na primeira execução (torchvision, re-ID).
# Padrão: junto do banco, em ~/Documents/dados-fluxo/modelos — fora do
# OneDrive pelo tamanho.
CAMINHO_MODELOS=

# Chave das rotas de escrita do serviço. Vazia = aberto, o certo para
# localhost. Antes de subir o serviço com --host 0.0.0.0, defina a MESMA
# chave no .env das duas máquinas (docs/operacao.md).
CHAVE_API=

# Senha do painel. Vazia = sem senha (só localhost). OBRIGATÓRIA antes de
# `rodar_tudo.py --tunel`: a aba "Ao vivo" mostra a porta da faculdade.
SENHA_PAINEL=

# Para onde o supervisor manda a URL do túnel quando ela muda: um tópico do
# ntfy.sh que o seu celular assina (app ntfy, ou https://ntfy.sh/<topico>).
# Escolha um nome difícil de adivinhar — quem souber o tópico recebe a URL.
URL_AVISO=https://ntfy.sh/limiar-troque-isto-a1b2c3

# Caminho do cloudflared, se não estiver no PATH nem em CAMINHO_FERRAMENTAS
# (scripts/instalar_tunel.py baixa para lá).
CLOUDFLARED=

# Último quadro anotado (aba Ao vivo) e binários baixados. Padrão: junto do
# banco, em ~/Documents/dados-fluxo/quadros e .../ferramentas.
CAMINHO_QUADROS=
CAMINHO_FERRAMENTAS=
